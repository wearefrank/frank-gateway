discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "apisix_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "apisix"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "apisix" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.apisix_logs.output
  forward_to = [loki.process.apisix_stdout_labels.receiver]
}

// Receive logs pushed in Loki format (e.g. APISIX loki-logger) and enrich
// them with audit labels before sending to Loki.
loki.source.api "apisix_loki_sender" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 3101
  }

  forward_to = [loki.process.apisix_audit_labels.receiver]
}

loki.process "apisix_audit_labels" {
  stage.static_labels {
    values = {
      audit_source    = "apisix-loki-sender",
      ingest_endpoint = "alloy-apisix-loki-receiver",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.process "apisix_stdout_labels" {
  // 1. Parse JSON fields from the stdout log line
  stage.json {
    expressions = {
      "log_type"    = "labels.log_type",
      "environment" = "labels.env",
    }
  }

  // 2. Assign extracted values as Loki stream labels
  stage.labels {
    values = {
      "log_type"    = "log_type",
      "environment" = "environment",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}