meta {
  name: current limitation - SOAPAction header quotes are not stripped
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/soap/myservice
  body: xml
}

headers {
  SOAPAction: "testOne"
  Content-Type: text/xml
}

body:xml {
  <Envelope/>
}

tests {
  test("quoted header is currently matched literally", function() {
    expect(res.getStatus()).to.equal(500);
    expect(res.getBody()).to.equal('No matching route found for SOAPAction: "testOne"');
  });
}
