headers {
  SOAPAction: testTwo
  Content-Type: text/xml
}

body:xml {
  <s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
    <s:Body><Value>header-only action</Value></s:Body>
  </s:Envelope>
}

tests {
