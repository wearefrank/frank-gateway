meta {
  name: WS-Addressing action with attributes is extracted
  type: http
  seq: 27
}

post {
  url: {{baseUrl}}/soap/myservice
  body: xml
}

headers {
  Content-Type: text/xml
}

body:xml {
  <s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" xmlns:wsa="http://www.w3.org/2005/08/addressing">
    <s:Header><wsa:Action s:mustUnderstand="1">testTwo</wsa:Action></s:Header>
    <s:Body/>
  </s:Envelope>
}

