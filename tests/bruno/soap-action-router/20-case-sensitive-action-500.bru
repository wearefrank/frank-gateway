meta {
  name: SOAP action values are matched case-sensitively
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/soap/myservice
  body: xml
}

headers {
  SOAPAction: TestOne
  Content-Type: text/xml
}

body:xml {
  <Envelope/>
}

tests {
  test("differently cased action has no matching route", function() {
    expect(res.getStatus()).to.equal(500);
    expect(res.getBody()).to.equal("No matching route found for SOAPAction: TestOne");
  });
}
