meta {
  name: nested SOAP body action matches the second route
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/soap/myservice
  body: xml
}

headers {
  Content-Type: text/xml
}

body:xml {
  <?xml version="1.0" encoding="UTF-8"?>
  <soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:urn="urn:example">
    <soap:Body>
      <urn:MyAction>
        <Payload>
          <Action>testOne</Action>
        </Payload>
      </urn:MyAction>
    </soap:Body>
  </soap:Envelope>
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("body extraction does not inject a SOAPAction header", function() {
    const headers = res.getBody().headers;
    expect(Object.keys(headers).some(key => key.toLowerCase() === "soapaction")).to.equal(false);
  });
}
