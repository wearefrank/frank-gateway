meta {
  name: matching action creates an inline HTTPBun upstream
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/soap/myservice
  body: xml
}

headers {
  SOAPAction: testInline
  Content-Type: text/xml
}

body:xml {
  <s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">
    <s:Body><Value>inline upstream request</Value></s:Body>
  </s:Envelope>
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("inline upstream uses the HTTPBun node host", function() {
    expect(res.getBody().url).to.equal("http://httpbun/anything");
  });
}
