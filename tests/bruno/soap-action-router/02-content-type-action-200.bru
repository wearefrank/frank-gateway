meta {
  name: action in Content-Type SOAP 1.2 returns 200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/soap/myservice
  body: xml
}

headers {
  Content-Type: application/soap+xml; charset=utf-8; action="testOne"
}

body:xml {
  <soapenv:Envelope xmlns:soapenv="http://www.w3.org/2003/05/soap-envelope" xmlns:urn="urn:example">
    <soapenv:Header/>
    <soapenv:Body>
      <urn:MyAction>
        <Value>content-type-only action</Value>
      </urn:MyAction>
    </soapenv:Body>
  </soapenv:Envelope>
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Content-Type action is forwarded unchanged", function() {
    const headers = res.getBody().headers;
    const key = Object.keys(headers).find(key => key.toLowerCase() === "content-type");
    expect(headers[key]).to.equal('application/soap+xml; charset=utf-8; action="testOne"');
  });
}
