meta {
  name: remember token request count before TLS failure
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/private-key-jwt/stats
}

script:post-response {
  bru.setEnvVar("tlsTokenRequestCount", res.getBody().token_requests);
}

tests {
  test("reads the mock identity provider request count", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().token_requests).to.be.a("number");
  });
}
