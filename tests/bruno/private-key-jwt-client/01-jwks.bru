meta {
  name: JWKS publishes public RSA key
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/private-key-jwt/jwks
}

tests {
  test("publishes only the public key", function() {
    expect(res.getStatus()).to.equal(200);
    const keys = res.getBody().keys;
    expect(keys).to.have.lengthOf(1);
    expect(keys[0]).to.include({ kid: "test-key", kty: "RSA", alg: "RS256", use: "sig" });
    expect(keys[0].n).to.match(/^[A-Za-z0-9_-]+$/);
    expect(keys[0].e).to.match(/^[A-Za-z0-9_-]+$/);
    expect(Object.keys(keys[0]).sort()).to.deep.equal(["alg", "e", "kid", "kty", "n", "use"]);
  });
}
